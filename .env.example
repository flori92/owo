# ============================================
# CONFIGURATION OWO! - VARIABLES D'ENVIRONNEMENT
# ============================================
#
# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs
# NE JAMAIS COMMITTER .env.local ou toute clé API réelle!
#
# ============================================

# ============================================
# NEON DATABASE (Backend)
# ============================================
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_API_KEY=your_neon_api_key_here
NEON_HOST=your_neon_host_here
NEON_DATABASE=neondb
NEON_USER=your_neon_user_here

# ============================================
# FIREBASE CONFIGURATION
# ============================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
