# ============================================
# CONFIGURATION OWO! - VARIABLES D'ENVIRONNEMENT
# ============================================
#
# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs
# NE JAMAIS COMMITTER .env.local ou toute clé API réelle!
#
# ============================================

# ============================================
# POSTGRESQL (API uniquement)
# ============================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=true
API_URL=https://api.example.com
CORS_ORIGINS=https://example.com

# ============================================
# FIREBASE CONFIGURATION
# ============================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Pages publiques obligatoires pour les stores
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
SUPPORT_URL=https://example.com/support
ACCOUNT_DELETION_URL=https://example.com/delete-account
SUPPORT_EMAIL=support@example.com

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
